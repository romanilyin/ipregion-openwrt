msgstr "Запустить DNS-проверку"

msgid "TLS"
msgstr "TLS"

msgid "Verified"
msgstr "Проверен"

msgid "OK"
msgstr "OK"

msgid "Fallback address"
msgstr "Резервный адрес"

msgid "Certificate failed"
msgstr "Ошибка сертификата"

msgid "TLS failed"
msgstr "Ошибка TLS"

msgid "Connection failed"
msgstr "Ошибка подключения"

msgid "HTTP error"
msgstr "Ошибка HTTP"

msgid "NXDOMAIN"
msgstr "NXDOMAIN"

msgid "SERVFAIL"
msgstr "SERVFAIL"

msgid "DNS error"
msgstr "Ошибка DNS"

msgid "No answer"
msgstr "Нет ответа"

msgid "Malformed response"
msgstr "Некорректный ответ"

msgid "Unavailable"
msgstr "Недоступен"

msgid "DNS transport"
msgstr "DNS-транспорт"

msgid "DNS worker did not stop"
msgstr "Не удалось остановить DNS worker"

msgid "returned a valid authenticated DNS response."
msgstr "вернул корректный аутентифицированный DNS-ответ."

msgid "succeeded through a fallback resolver address."
msgstr "успешно сработал через резервный адрес резолвера."

msgid "did not respond before timeout; the endpoint or transport may be dropped."
msgstr "не ответил до истечения таймаута; endpoint или транспорт может блокироваться."

msgid "certificate validation failed; check system time or possible TLS interception."
msgstr "не прошел проверку сертификата; проверьте системное время и возможный перехват TLS."

msgid "TLS handshake failed."
msgstr "не смог установить TLS-соединение."

msgid "Connection failed or was reset."
msgstr "не смог установить соединение или соединение было сброшено."

msgid "DoH returned an HTTP error."
msgstr "DoH вернул ошибку HTTP."

msgid "The resolver returned NXDOMAIN for the probe name."
msgstr "Резолвер вернул NXDOMAIN для проверяемого имени."

msgid "The resolver returned SERVFAIL for the probe name."
msgstr "Резолвер вернул SERVFAIL для проверяемого имени."

msgid "The resolver returned a DNS error response."
msgstr "Резолвер вернул ответ с ошибкой DNS."

msgid "The resolver returned NOERROR without a usable answer."
msgstr "Резолвер вернул NOERROR без пригодного ответа."

msgid "The endpoint returned a malformed or mismatched DNS response."
msgstr "Endpoint вернул некорректный или не соответствующий запросу DNS-ответ."

msgid "The requested DNS transport is unavailable."
msgstr "Запрошенный DNS-транспорт недоступен."

msgid "DoH and DoT returned different DNS response codes."
msgstr "DoH и DoT вернули разные коды DNS-ответа."

msgid "DoH and DoT returned different answers; resolver or CDN variation may be legitimate."
msgstr "DoH и DoT вернули разные ответы; это может быть допустимой вариацией резолвера или CDN."

msgid "DoH works while DoT fails; TCP/853 may be filtered."
msgstr "DoH работает, а DoT нет; TCP/853 может фильтроваться."

msgid "DoT works while DoH fails; the DoH endpoint may be filtered."
msgstr "DoT работает, а DoH нет; DoH endpoint может фильтроваться."

msgid "both encrypted DNS transports are unavailable."
msgstr "оба транспорта зашифрованного DNS недоступны."

msgid "Stop the DNS security check before clearing its results"
msgstr "Остановите проверку безопасности DNS перед очисткой ее результатов"

msgid "DNS query name is invalid"
msgstr "Некорректное DNS-имя запроса"

msgid "DNS provider is invalid"
msgstr "Некорректный DNS-провайдер"

msgid "Network interface is invalid"
msgstr "Некорректный сетевой интерфейс"

msgid "Unknown error"
msgstr "Неизвестная ошибка"

msgid "No DNS providers matched the requested filters"
msgstr "Нет DNS-провайдеров, соответствующих выбранным фильтрам"

msgid "No selected DNS provider supports the requested transport"
msgstr "Ни один выбранный DNS-провайдер не поддерживает запрошенный транспорт"

msgid "Truncated"
msgstr "Усеченный ответ"

msgid "returned a valid direct DNS response."
msgstr "вернул корректный прямой DNS-ответ."

msgid "The UDP response was truncated and was not retried over TCP."
msgstr "UDP-ответ был усечен и не повторялся автоматически через TCP."

msgid "UDP/53 is unavailable."
msgstr "UDP/53 недоступен."

msgid "TCP/53 is unavailable."
msgstr "TCP/53 недоступен."

msgid "Plain and authenticated DNS returned different answers; resolver or CDN variation may be legitimate."
msgstr "Открытый и аутентифицированный DNS вернули разные ответы; это может быть допустимой вариацией резолвера или CDN."

msgid "UDP/53 returned a different DNS response code while TCP/53 matched authenticated DNS; UDP interception is likely."
msgstr "UDP/53 вернул другой код DNS-ответа, а TCP/53 совпал с аутентифицированным DNS; вероятен перехват UDP."

msgid "TCP/53 returned a different DNS response code while UDP/53 matched authenticated DNS; TCP interception is likely."
msgstr "TCP/53 вернул другой код DNS-ответа, а UDP/53 совпал с аутентифицированным DNS; вероятен перехват TCP."

msgid "UDP/53 and TCP/53 agree with each other but differ from authenticated DNS; plain DNS interception is likely."
msgstr "UDP/53 и TCP/53 совпали между собой, но отличаются от аутентифицированного DNS; вероятен перехват открытого DNS."

msgid "Likely DNS interception"
msgstr "Вероятен перехват DNS"

msgid "No DNS response mismatch detected"
msgstr "Расхождений DNS-ответов не обнаружено"

msgid "Interception check inconclusive"
msgstr "Проверка перехвата не дала однозначного результата"

msgid "Interception comparison pending"
msgstr "Сравнение на перехват выполняется"

msgid "Interception comparison not run"
msgstr "Сравнение на перехват не выполнялось"

msgid "IPRegion DNS helper is required for UDP, TCP and DNS-over-TLS checks"
msgstr "Для проверок UDP, TCP и DNS-over-TLS требуется DNS helper IPRegion"

msgid "DNS results"
msgstr "Результаты DNS"

msgid "One run checks direct UDP/53, TCP/53, DoH and DoT responses in the same table. TLS hostnames are verified for encrypted transports."
msgstr "Один запуск проверяет прямые ответы UDP/53, TCP/53, DoH и DoT в общей таблице. Для зашифрованных транспортов проверяются TLS-имена."

msgid "The single DNS run checks UDP/53, TCP/53, DoH and DoT using the IP mode, interface and timeout controls above. SOCKS5 proxy routing is not used."
msgstr "Единый DNS-запуск проверяет UDP/53, TCP/53, DoH и DoT с выбранными выше режимом IP, интерфейсом и таймаутом. Маршрутизация через SOCKS5-прокси не используется."

msgid "Matching responses mean no mismatch was detected; they do not prove that interception is absent."
msgstr "Совпадающие ответы означают только отсутствие обнаруженных расхождений, но не доказывают отсутствие перехвата."

msgid "Compare UDP/53, TCP/53, DoH and DoT responses from public and active-interface DNS resolvers in one check."
msgstr "Сравнивает ответы UDP/53, TCP/53, DoH и DoT от публичных DNS и DNS активного интерфейса в одной проверке."

msgid "AI provider check failed to start"
msgstr "Не удалось запустить проверку AI-провайдеров"

msgid "Automatic clipboard access failed. Copy the Markdown text manually."
msgstr "Автоматический доступ к буферу обмена не сработал. Скопируйте текст Markdown вручную."

msgid "Copy Markdown"
msgstr "Копировать Markdown"

msgid "Default SOCKS5 proxy profile"
msgstr "Профиль SOCKS5 proxy по умолчанию"

msgid "Define SOCKS5 proxy profiles in Settings, then select one here for GeoIP, service and AI checks."
msgstr "Создайте профили SOCKS5 proxy в настройках, затем выберите один здесь для проверок GeoIP, сервисов и AI."

msgid "Define multiple SOCKS5 endpoints, for example Podkop mixed proxies, and select any profile on the Status page."
msgstr "Задайте несколько SOCKS5 endpoint-ов, например mixed proxy Podkop, и выбирайте нужный профиль на странице Status."

msgid "IP Region check failed to start"
msgstr "Не удалось запустить проверку IP Region"

msgid "Legacy SOCKS5 proxy"
msgstr "Прежний SOCKS5 proxy"

msgid "Markdown copied to clipboard."
msgstr "Markdown скопирован в буфер обмена."

msgid "Profile name"
msgstr "Имя профиля"

msgid "Profile name is required"
msgstr "Имя профиля обязательно"

msgid "Run a check before copying Markdown."
msgstr "Перед копированием Markdown запустите проверку."

msgid "SOCKS5 proxy address or DNS mode is invalid"
msgstr "Некорректный адрес SOCKS5 proxy или режим DNS"

msgid "SOCKS5 proxy profile is invalid"
msgstr "Некорректный профиль SOCKS5 proxy"

msgid "SOCKS5 proxy profiles"
msgstr "Профили SOCKS5 proxy"

msgid "Selected SOCKS5 proxy profile does not exist or is invalid"
msgstr "Выбранный профиль SOCKS5 proxy не существует или некорректен"

msgid "APK"
msgstr "APK"

msgid "APK size"
msgstr "Размер APK"

msgid "APK size is the compressed download size. Installed size is the package footprint in flash storage."
msgstr "Размер APK показывает объем скачиваемого архива. Установленный размер показывает место, занятое пакетом во flash-памяти."

msgid "Cancel"
msgstr "Отмена"

msgid "Could not remove knot-dig"
msgstr "Не удалось удалить knot-dig"

msgid "DNS transport helper"
msgstr "Транспортный DNS helper"

msgid "Estimated space to reclaim"
msgstr "Ожидаемое освобождаемое место"

msgid "IPRegion backend"
msgstr "Backend IPRegion"

msgid "IPRegion now uses its own DNS helper. Removing knot-dig will also remove dependencies that no other package needs."
msgstr "Теперь IPRegion использует собственный DNS helper. При удалении knot-dig также будут удалены зависимости, не нужные другим пакетам."

msgid "Installed"
msgstr "Установлен"

msgid "Installed IPRegion packages total"
msgstr "Всего установлено пакетами IPRegion"

msgid "Installed size"
msgstr "Установленный размер"

msgid "Legacy DNS utility"
msgstr "Прежняя DNS-утилита"

msgid "LuCI application"
msgstr "Приложение LuCI"

msgid "Not installed"
msgstr "Не установлен"

msgid "Package"
msgstr "Пакет"

