msgid "All"
msgstr "Все"

msgid "All groups run every enabled GeoIP, popular service and CDN check."
msgstr "Все группы запускают все включенные проверки GeoIP, популярных сервисов и CDN."

msgid "All AI providers"
msgstr "Все AI-провайдеры"

msgid "All providers"
msgstr "Все провайдеры"

msgid "AI category"
msgstr "Категория AI"

msgid "AI provider check started"
msgstr "Проверка AI-провайдеров запущена"

msgid "AI provider checks use the same IP mode, interface, proxy and timeout controls above."
msgstr "AI-проверки используют выбранные выше режим IP, интерфейс, прокси и таймаут."

msgid "AI provider endpoint results"
msgstr "Результаты endpoint-ов AI-провайдеров"

msgid "AI Providers"
msgstr "AI-провайдеры"

msgid "ASN"
msgstr "ASN"

msgid "Auto"
msgstr "Авто"

msgid "Auto-detect reference country"
msgstr "Автоопределить реальную страну"

msgid "Cache TTL"
msgstr "TTL кэша"

msgid "CDN services"
msgstr "CDN-сервисы"

msgid "CDN services check which CDN edge or region the router reaches, for example Cloudflare, YouTube or Netflix."
msgstr "CDN-сервисы проверяют, до какого CDN edge или региона доходит роутер, например Cloudflare, YouTube или Netflix."

msgid "Category"
msgstr "Категория"

msgid "Check how GeoIP, streaming and CDN services detect this router."
msgstr "Проверяет, как GeoIP, стриминговые и CDN-сервисы видят этот роутер."

msgid "Check how GeoIP, streaming, CDN and AI services detect this router."
msgstr "Проверяет, как GeoIP, стриминговые, CDN и AI-сервисы видят этот роутер."

msgid "Check discovered IP"
msgstr "Проверять обнаруженный IP"

msgid "Check service-visible route"
msgstr "Проверять маршрут глазами сервиса"

msgid "Check whether popular AI API endpoints are reachable through this router, interface or SOCKS5 proxy."
msgstr "Проверяет, доступны ли популярные AI API endpoint-ы через этот роутер, интерфейс или SOCKS5-прокси."

msgid "Check whether popular AI API endpoints are reachable through the selected route."
msgstr "Проверяет, доступны ли популярные AI API endpoint-ы через выбранный маршрут."

msgid "China and Asia AI providers"
msgstr "AI-провайдеры Китая и Азии"

msgid "Clear cache"
msgstr "Очистить кэш"

msgid "Close"
msgstr "Закрыть"

msgid "Configure default diagnostics options."
msgstr "Настройка параметров диагностики по умолчанию."

msgid "Country"
msgstr "Страна"

msgid "Could not update reference country field."
msgstr "Не удалось обновить поле реальной страны."

msgid "Current check"
msgstr "Текущая проверка"

msgid "Debug logging"
msgstr "Отладочный лог"

msgid "Default group"
msgstr "Группа по умолчанию"

msgid "Default route"
msgstr "Маршрут по умолчанию"

msgid "Disabled services"
msgstr "Отключенные сервисы"

msgid "Download JSON"
msgstr "Скачать JSON"

msgid "Diagnosis"
msgstr "Диагностика"

msgid "Enable"
msgstr "Включить"

msgid "Each row checks the actual provider endpoint domain. With split routing, this can differ from the generic egress check below."
msgstr "Каждая строка проверяет реальный домен endpoint-а провайдера. При split routing это может отличаться от общей проверки исходящего IP ниже."

msgid "Generic egress check"
msgstr "Общая проверка исходящего IP"

msgid "Errors"
msgstr "Ошибки"

msgid "GeoIP services"
msgstr "GeoIP-сервисы"

msgid "GeoIP services query public geolocation APIs and registries to see what country they assign to the router IP."
msgstr "GeoIP-сервисы обращаются к публичным геолокационным API и реестрам, чтобы узнать, какую страну они назначают IP-адресу роутера."

msgid "GeoIP lookup checks the discovered router IP. Service-visible route asks supported GeoIP APIs what country they see for this exact request path."
msgstr "GeoIP lookup проверяет обнаруженный IP роутера. Режим маршрута спрашивает поддерживаемые GeoIP API, какую страну они видят для этого конкретного запроса."

msgid "GeoIP mode"
msgstr "Режим GeoIP"

msgid "Global AI providers"
msgstr "Глобальные AI-провайдеры"

msgid "Group"
msgstr "Группа"

msgid "HTTP"
msgstr "HTTP"

msgid "Idle"
msgstr "Ожидание"

msgid "Interface"
msgstr "Интерфейс"

msgid "IP mode"
msgstr "Режим IP"

msgid "IP Region"
msgstr "IP Region"

msgid "IP Region check started"
msgstr "Проверка IP Region запущена"

msgid "IP"
msgstr "IP"

msgid "ISO 3166-1 alpha-2 country code used to highlight country values. Matching countries are orange; different countries are blue."
msgstr "Двухбуквенный код страны ISO 3166-1 alpha-2 для подсветки значений стран. Совпадающие страны будут оранжевыми, отличающиеся - синими."

msgid "GitHub version not found"
msgstr "Версия на GitHub не найдена"

msgid "GitHub repository"
msgstr "Репозиторий GitHub"

msgid "Installed version"
msgstr "Установленная версия"

msgid "Installed version not found"
msgstr "Установленная версия не найдена"

msgid "IPv4"
msgstr "IPv4"

msgid "IPv4 and IPv6"
msgstr "IPv4 и IPv6"

msgid "IPv4 only"
msgstr "Только IPv4"

msgid "IPv4 value/status"
msgstr "IPv4 значение/статус"

msgid "IPv6"
msgstr "IPv6"

msgid "IPv6 only"
msgstr "Только IPv6"

msgid "IPv6 value/status"
msgstr "IPv6 значение/статус"

msgid "Keep logs"
msgstr "Сохранять логи"

msgid "Last check"
msgstr "Последняя проверка"

msgid "Latest GitHub version"
msgstr "Последняя версия на GitHub"

msgid "Latest version installed"
msgstr "Установлена последняя версия"

msgid "Local DNS"
msgstr "Локальный DNS"

msgid "Log is empty"
msgstr "Лог пуст"

msgid "Mask IP addresses in UI"
msgstr "Маскировать IP-адреса в UI"

msgid "Max parallel checks"
msgstr "Максимум параллельных проверок"

msgid "N/A"
msgstr "Н/Д"

msgid "Network"
msgstr "Сеть"

msgid "No proxy"
msgstr "Без прокси"

msgid "No results yet"
msgstr "Результатов пока нет"

msgid "Open status page"
msgstr "Открыть страницу статуса"

msgid "PID"
msgstr "PID"

msgid "Popular services"
msgstr "Популярные сервисы"

msgid "Popular services contact major platforms to see which region, access state or country their web/API endpoints report for this route."
msgstr "Популярные сервисы обращаются к крупным платформам и показывают, какой регион, доступ или страну их веб/API-эндпоинты видят для этого маршрута."

msgid "Progress"
msgstr "Прогресс"

msgid "Package version"
msgstr "Версия пакета"

msgid "Provider"
msgstr "Провайдер"

msgid "Proxy"
msgstr "Прокси"

msgid "Refresh result"
msgstr "Обновить результат"

msgid "Reference country"
msgstr "Реальная страна"

msgid "Reference country detected"
msgstr "Реальная страна определена"

msgid "Reference country must be a two-letter country code, for example RU."
msgstr "Реальная страна должна быть двухбуквенным кодом, например RU."

msgid "Remote DNS"
msgstr "Удаленный DNS"

msgid "Retries"
msgstr "Повторы"

msgid "Run check"
msgstr "Запустить проверку"

msgid "Run AI check"
msgstr "Запустить AI-проверку"

msgid "Run checks and inspect results on the Status page."
msgstr "Запускайте проверки и смотрите результаты на странице статуса."

msgid "Run a GeoIP check before auto-detecting the reference country."
msgstr "Запустите GeoIP-проверку перед автоопределением реальной страны."

msgid "Running"
msgstr "Выполняется"

msgid "Runtime log"
msgstr "Лог выполнения"

msgid "Runtime state"
msgstr "Состояние выполнения"

msgid "Saved SOCKS5 proxy"
msgstr "Сохраненный SOCKS5-прокси"

msgid "Safe mode is used by default. It does not store API keys and only checks whether provider endpoint domains are reachable through their selected routes."
msgstr "По умолчанию используется безопасный режим. Он не хранит API-ключи и только проверяет доступность доменов endpoint-ов провайдеров через выбранные для них маршруты."

msgid "Self-test"
msgstr "Самопроверка"

msgid "Service"
msgstr "Сервис"

msgid "Service id must contain only uppercase letters, numbers and underscores"
msgstr "ID сервиса должен содержать только заглавные латинские буквы, цифры и подчеркивания"

msgid "Settings"
msgstr "Настройки"

msgid "Show log"
msgstr "Показать лог"

msgid "SOCKS5 DNS mode"
msgstr "Режим DNS для SOCKS5"

msgid "SOCKS5 proxy"
msgstr "SOCKS5-прокси"

msgid "Stop"
msgstr "Остановить"

msgid "Status"
msgstr "Статус"

msgid "Timeout"
msgstr "Таймаут"

msgid "This is a generic IP/ASN check for the selected route. In domain-based split routing, individual AI provider endpoints may use a different VPN route; check the provider rows above."
msgstr "Это общая проверка IP/ASN для выбранного маршрута. При split routing по доменам отдельные AI endpoint-ы могут идти через другой VPN-маршрут; смотрите строки провайдеров выше."

msgid "Time"
msgstr "Время"

msgid "Update available"
msgstr "Доступно обновление"

msgid "Update failed to start"
msgstr "Не удалось запустить обновление"

msgid "Update is running"
msgstr "Обновление выполняется"

msgid "Update package"
msgstr "Обновить пакет"

msgid "Uses the latest successful GeoIP results. Run a check on the Status page first if no country is available."
msgstr "Использует последние успешные результаты GeoIP. Если страна недоступна, сначала запустите проверку на странице статуса."

msgid "Update started"
msgstr "Обновление запущено"

msgid "Where to see results"
msgstr "Где смотреть результаты"

msgid "AI provider checks use the same IP mode, interface, proxy and timeout controls above. IPv4 and IPv6 mode checks both transports separately."
msgstr "AI-проверки используют выбранные выше режим IP, интерфейс, прокси и таймаут. Режим IPv4 и IPv6 проверяет оба транспорта отдельно."

msgid "Clear results"
msgstr "Очистить результаты"

msgid "Download JSON includes raw IP addresses."
msgstr "Скачанный JSON содержит исходные IP-адреса."

msgid "Installed and GitHub versions differ"
msgstr "Установленная версия отличается от версии на GitHub"

msgid "Installed version is newer than the latest GitHub release"
msgstr "Установленная версия новее последнего GitHub release"

msgid "Transport"
msgstr "Транспорт"

msgid "Update package installs APKs from GitHub Releases using the repository installer."
msgstr "Обновление пакета устанавливает APK из GitHub Releases через installer репозитория."

msgid "When IPv4 and IPv6 mode is selected, each provider gets separate IPv4 and IPv6 rows; unavailable transports are shown explicitly."
msgstr "В режиме IPv4 и IPv6 каждый провайдер получает отдельные строки IPv4 и IPv6; недоступные транспорты показываются явно."

msgid "Open settings"
msgstr "Открыть настройки"

msgid "Remote DNS uses socks5h:// and resolves names through the proxy. Local DNS uses socks5:// and resolves names on the router."
msgstr "Удаленный DNS использует socks5h:// и резолвит имена через прокси. Локальный DNS использует socks5:// и резолвит имена на роутере."

msgid "SOCKS5 proxy must be host:port, for example 127.0.0.1:1080"
msgstr "SOCKS5 proxy должен быть в формате host:port, например 127.0.0.1:1080"

msgid "Saved proxy shown on Status page. Enter host:port without socks5:// prefix, for example 127.0.0.1:1080."
msgstr "Сохраненный proxy показывается на странице Status. Введите host:port без префикса socks5://, например 127.0.0.1:1080."

msgid "Set the saved SOCKS5 proxy in Settings, then select it here for checks."
msgstr "Задайте сохраненный SOCKS5 proxy в настройках, затем выберите его здесь для проверок."

msgid "Use saved SOCKS5 proxy"
msgstr "Использовать сохраненный SOCKS5 proxy"

msgid "A successful encrypted DNS check does not prove that ordinary UDP or TCP port 53 is free from interception."
msgstr "Успешная проверка зашифрованного DNS не доказывает отсутствие перехвата обычного UDP или TCP на порту 53."

msgid "Answer"
msgstr "Ответ"

msgid "Check whether major public DNS resolvers are reachable over authenticated DoH and DoT connections."
msgstr "Проверяет доступность основных публичных DNS-резолверов через аутентифицированные соединения DoH и DoT."

msgid "DNS Security"
msgstr "Безопасность DNS"

msgid "DNS checks use the IP mode, interface and timeout controls above. DoH binds to the selected interface; DoT binds to its source address. SOCKS5 proxy routing is not used."
msgstr "DNS-проверки используют выбранные выше режим IP, интерфейс и таймаут. DoH привязывается к выбранному интерфейсу, а DoT - к его исходному адресу. SOCKS5-прокси не применяется."

msgid "DNS provider"
msgstr "DNS-провайдер"

msgid "DNS security check started"
msgstr "Проверка безопасности DNS запущена"

msgid "DNS security check failed to start"
msgstr "Не удалось запустить проверку безопасности DNS"

msgid "DNS security check failed to stop"
msgstr "Не удалось остановить проверку безопасности DNS"

msgid "DNS security summary"
msgstr "Сводка безопасности DNS"

msgid "DNS status"
msgstr "Статус DNS"

msgid "DoH and DoT"
msgstr "DoH и DoT"

msgid "DoH and DoT connect directly to published resolver IP addresses and verify the provider TLS hostname."
msgstr "DoH и DoT подключаются напрямую к опубликованным IP-адресам резолвера и проверяют TLS-имя провайдера."

msgid "DoH only"
msgstr "Только DoH"

msgid "DoT only"
msgstr "Только DoT"

msgid "Encrypted DNS results"
msgstr "Результаты зашифрованного DNS"

msgid "Encrypted DNS transport"
msgstr "Транспорт зашифрованного DNS"

msgid "Endpoint"
msgstr "Endpoint"

msgid "Failed"
msgstr "Ошибок"

msgid "Findings"
msgstr "Выводы"

msgid "Not verified"
msgstr "Не проверен"

msgid "Passed"
msgstr "Успешно"

msgid "Probe name"
msgstr "Проверяемое имя"

msgid "Record type"
msgstr "Тип записи"

msgid "Run DNS check"
msgstr "Запустить DNS-проверку"

msgid "TLS"
msgstr "TLS"

msgid "Verified"
msgstr "Проверен"

msgid "OK"
msgstr "OK"

msgid "Fallback address"
msgstr "Резервный адрес"

msgid "Certificate failed"
msgstr "Ошибка сертификата"

msgid "TLS failed"
msgstr "Ошибка TLS"

msgid "Connection failed"
msgstr "Ошибка подключения"

msgid "HTTP error"
msgstr "Ошибка HTTP"

msgid "NXDOMAIN"
msgstr "NXDOMAIN"

msgid "SERVFAIL"
msgstr "SERVFAIL"

msgid "DNS error"
msgstr "Ошибка DNS"

msgid "No answer"
msgstr "Нет ответа"

msgid "Malformed response"
msgstr "Некорректный ответ"

msgid "Unavailable"
msgstr "Недоступен"

msgid "DNS transport"
msgstr "DNS-транспорт"

msgid "DNS worker did not stop"
msgstr "Не удалось остановить DNS worker"

msgid "returned a valid authenticated DNS response."
msgstr "вернул корректный аутентифицированный DNS-ответ."

msgid "succeeded through a fallback resolver address."
msgstr "успешно сработал через резервный адрес резолвера."

msgid "did not respond before timeout; the endpoint or transport may be dropped."
msgstr "не ответил до истечения таймаута; endpoint или транспорт может блокироваться."

msgid "certificate validation failed; check system time or possible TLS interception."
msgstr "не прошел проверку сертификата; проверьте системное время и возможный перехват TLS."

msgid "TLS handshake failed."
msgstr "не смог установить TLS-соединение."

msgid "TCP connection failed or was reset."
msgstr "не смог установить TCP-соединение или соединение было сброшено."

msgid "DoH returned an HTTP error."
msgstr "DoH вернул ошибку HTTP."

msgid "The resolver returned NXDOMAIN for the probe name."
msgstr "Резолвер вернул NXDOMAIN для проверяемого имени."

msgid "The resolver returned SERVFAIL for the probe name."
msgstr "Резолвер вернул SERVFAIL для проверяемого имени."

msgid "The resolver returned a DNS error response."
msgstr "Резолвер вернул ответ с ошибкой DNS."

msgid "The resolver returned NOERROR without a usable answer."
msgstr "Резолвер вернул NOERROR без пригодного ответа."

msgid "The endpoint returned a malformed or mismatched DNS response."
msgstr "Endpoint вернул некорректный или не соответствующий запросу DNS-ответ."

msgid "The requested DNS transport is unavailable."
msgstr "Запрошенный DNS-транспорт недоступен."

msgid "DoH and DoT returned different DNS response codes."
msgstr "DoH и DoT вернули разные коды DNS-ответа."

msgid "DoH and DoT returned different answers; resolver or CDN variation may be legitimate."
msgstr "DoH и DoT вернули разные ответы; это может быть допустимой вариацией резолвера или CDN."

msgid "DoH works while DoT fails; TCP/853 may be filtered."
msgstr "DoH работает, а DoT нет; TCP/853 может фильтроваться."

msgid "DoT works while DoH fails; the DoH endpoint may be filtered."
msgstr "DoT работает, а DoH нет; DoH endpoint может фильтроваться."

msgid "both encrypted DNS transports are unavailable."
msgstr "оба транспорта зашифрованного DNS недоступны."

msgid "Stop the DNS security check before clearing its results"
msgstr "Остановите проверку безопасности DNS перед очисткой ее результатов"

msgid "DNS query name is invalid"
msgstr "Некорректное DNS-имя запроса"

msgid "DNS provider is invalid"
msgstr "Некорректный DNS-провайдер"

msgid "Network interface is invalid"
msgstr "Некорректный сетевой интерфейс"

msgid "Unknown error"
msgstr "Неизвестная ошибка"

msgid "No DNS providers matched the requested filters"
msgstr "Нет DNS-провайдеров, соответствующих выбранным фильтрам"

msgid "kdig is required for DNS-over-TLS checks"
msgstr "Для проверок DNS-over-TLS требуется kdig"
